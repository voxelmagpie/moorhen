root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true

[*.mh]
indent_style = tab
indent_size = 2
charset = latin1
trim_trailing_whitespace = true

[*.hs]
indent_style = space
indent_size = 2
charset = latin1
trim_trailing_whitespace = true
