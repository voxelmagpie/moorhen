import "maybe" (..)

mod VecFns [A] for Vec[A]
	let iter (xs : Self) : Iter[A]
		xs.iterFrom(0)

	iterator iterFrom (xs : Self, mut i : Int) : A
		loop
			match xs.at(i)
				None
					break
				Some(x)
					yield x
					set i = i + 1

	iterator iterRev (xs : Self) : A
		let mut i = xs.length() - 1
		loop
			match xs.at(i)
				None
					break
				Some(x)
					yield x
					set i = i - 1

	let at (xs : Vec[A], i : Int) : Maybe[A]
		if i < 0 or i >= xs.length() then None else Some(xs.atOrPanic(i))

	let reverse (xs : Vec[A]) : Vec[A]
		buildVec(xs.length(), \i -> xs.atOrPanic(xs.length() - i - 1))
