import "maybe" (..)
import "stack" (..)
import "vec" (..)


// TODO Remove the Int from Stack and remove this
data LinkedList [A] = Empty | Next(A, LinkedList[A])

iterator emptyIter [A] () : A
	()

iterator singletonIter [A] (x : A) : A
	yield x


mod IterFns [A] for Iter[A]
	// Evaluates first value, if there is one
	let isEmpty (it : Self) : Bool
		let mut empty = true

		foreach _ in it
			set empty = false
			break

		empty

	let length (mut it : Self) : Int
		let mut l = 0

		foreach _ in it
			set l = l + 1

		l

	iterator map [B] (xs : Self, f : \A -> B) : B
		foreach x in xs
			yield f(x)

	iterator mapMaybe [B] (xs : Self, f : \A -> Maybe[B]) : B
		foreach x in xs
			match f(x)
				None -> ()
				Some(x) -> yield x

	let find (xs : Self, f : \A -> Bool) : Maybe[A]
		let mut found : Maybe[A] = None

		foreach x in xs
			if f(x)
				set found = Some(x)
				break

		found

	// TODO foreach x,y in xs,ys
	// iterator zip [B] (xs : Self, ys : Iter[B]) : (A, B)

	iterator filter (xs : Self, f : \A -> Bool) : A
		foreach x in xs
			if f(x)
				yield x

	iterator filterMap [B] (xs : Self, f : \A -> Maybe[B]) : B
		foreach x in xs
			match f(x)
				Some(x) -> yield x
				None -> ()

	let fold (mut xs : Self, f : \A, A -> A, init : A) : A
		xs.fold_(f, init)

	let fold_ [B] (mut xs : Self, f : \B, A -> B, init : B) : B
		let mut acc = init

		foreach x in xs
			set acc = f(acc, x)

		acc

	iterator take (it : Self, mut n : Int) : A
		if n <= 0
			()
		else
			foreach x in it
				yield x
				set n = n - 1
				if n <= 0
					break


	iterator skip (it : Self, mut n : Int) : A
		foreach x in it
			if n > 0
				set n = n - 1
				continue

			yield x

	iterator append ++ (it0 : Self, it1 : Self) : A
		foreach x in it0
			yield x

		foreach x in it1
			yield x

	// Evaluates the entire iterator
	let reverse (xs : Self) : Self
		xs.collect().iterRev()

	iterator enumFrom (xs : Self, mut i : Int) : (Int, A)
		foreach x in xs
			yield (i, x)
			set i = i + 1

	// Enumerates an iterator
	// E.g. [a, b, c] -> [(0, a), (1, b), (2, c)]
	let enum (xs : Self) : Iter[(Int, A)]
		xs.enumFrom(0)


	let collect (xs : Self) : Vec[A]
		let mut resRev : LinkedList[A] = Empty
		let mut l = 0

		foreach x in xs
			set resRev = Next(x, resRev)
			set l = l + 1

		buildVecRev(
			l
			\_ ->
				match resRev
					Empty -> undefined
					Next(x, xs)
						set resRev = xs
						x
		)

